        {"action": "fill", "selector": "input[placeholder='8-128个字符，须含大小写字母和数字']", "value": "Test123456"},
        {"action": "fill", "selector": "input[placeholder='请再次输入密码']", "value": "Test1234567"},
        {"action": "click", "selector": "button.submit-btn"},
        {"action": "expect", "kind": "toast", "text": "两次输入的密码不一致"}
      ],
      "expect": "提示「两次输入的密码不一致」，无请求"
    },
    {
      "id": "TC03", "priority": "P1",
      "desc": "密码过短（Ab1）",
      "precondition": "未登录",
      "semantic": "normal",
      "defect": "OBS-001",
