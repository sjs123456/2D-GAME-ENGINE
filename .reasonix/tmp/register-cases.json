        {"action": "fill", "selector": "input[placeholder='8-128个字符，须含大小写字母和数字']", "value": "Ab1"},
        {"action": "fill", "selector": "input[placeholder='请再次输入密码']", "value": "Ab1"},
        {"action": "click", "selector": "button.submit-btn"},
        {"action": "expect", "kind": "toast", "text": "at least 8 characters"}
      ],
      "expect": "后端 422 拒绝并提示；出现英文提示属 OBS-001 已知现象"
    },
