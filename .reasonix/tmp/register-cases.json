{
  "meta": {
    "module": "register",
    "title": "注册页用例集 v1",
    "base_url": "http://123.56.21.178:8080",
    "ts_placeholder": "<ts>"
  },
  "cases": [
    {
      "id": "TC01", "priority": "P0",
      "desc": "正常注册成功（唯一账号 testuser_r<ts>）",
      "precondition": "未登录，无同名账号",
      "semantic": "normal",
      "steps": [
        {"action": "goto", "url": "/login"},
        {"action": "click", "selector": "button.tab-btn:has-text('注册')"},
        {"action": "fill", "selector": "input[placeholder='3-50个字符，字母数字下划线']", "value": "testuser_r<ts>"},
        {"action": "fill", "selector": "input[placeholder='请输入邮箱地址']", "value": "testuser_r<ts>@test.com"},
        {"action": "fill", "selector": "input[placeholder='8-128个字符，须含大小写字母和数字']", "value": "Test123456"},
        {"action": "fill", "selector": "input[placeholder='请再次输入密码']", "value": "Test123456"},
        {"action": "click", "selector": "button.submit-btn"},
        {"action": "expect", "kind": "toast", "text": "注册成功"}
      ],
      "expect": "toast「注册成功，请登录」，自动切回登录 tab"
    },
    {
      "id": "TC02", "priority": "P1",
      "desc": "密码与确认密码不一致",
